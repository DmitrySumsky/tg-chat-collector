# Токен бота от @BotFather. У бота должен быть выключен privacy mode,
# и после выключения его надо переподключить в чатах, где он уже состоит.
TG_INTAKE_BOT_TOKEN=

# Белый список чатов: id через запятую. Пусто = не собирается ничего.
# Узнать id: запустить с --once, затем --list-chats.
ALLOWED_CHATS=

# Либо файл со списком: {"chats": [{"chat_id": -1001234567890, "title": "…"}]}
# ALLOWED_CHATS_FILE=allowed.json

# Куда писать. На сервере — путь на постоянном томе.
DB_PATH=chats.sqlite3

# Папка для вложений. Не задана — вложения не скачиваются.
# MEDIA_DIR=media

# Необязательная пересылка каждого сообщения в приложение.
# INGEST_URL=https://example.com/api/telegram/ingest
# INGEST_TOKEN=
